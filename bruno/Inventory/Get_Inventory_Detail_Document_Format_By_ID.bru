  name: Get Inventory Detail Document Format By ID
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/inventory/detail/:id/doc
  body: none
  auth: bearer
}

params:path {
  id: e1288783-a5d4-1c4c-2cd6-0e92f7cc3bf9
}

